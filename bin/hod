#!/usr/bin/env bash

set -euo pipefail

HOD_VERSION=0.1.15
HOD_REPO_URL="${HOD_REPO_URL:-https://github.com/hapo-nghialuu/hod.git}"

usage() {
  cat <<'EOF'
Usage:
  hod install [--project <path>] [--ref <git-ref>] [--no-memo | --memo-strict | --memo-default]
  hod status
  hod doctor
  hod update
  hod uninstall [--project <path>] [--purge] [--no-memo]
  hod settings list
  hod settings install [--project <path>] [--role <name>] [--force]
  hod ui [--project <path>] [--port <0-65535>] [--no-open]
  hod start [--port <0-65535>] [--no-open]
  hod version
  hod help

Herdr Orchestrator Driver (hod) — install and manage the herdr-orchestrator skill.

Subcommands:
  install     Clone-or-update the skill checkout and create adapter symlinks
              (global by default; --project installs into one Git project)
  status      Report prerequisites, skill checkout, adapters, and PATH
  doctor      status plus remediation and deeper health checks
  update      Fast-forward the skill checkout (refuses local modifications)
  uninstall   Remove hod-managed adapter symlinks; --purge also removes skill data
  settings    Copy per-role Claude Code settings profiles into a project
              (list shows the roles; install writes .claude/settings.<role>.json)
  ui          Launch the local HOD web console (Node.js 20+)
  start       Launch the foreground, loopback-only runtime observer (Node.js 20+)
  version     Print the hod version
  help        Show this help

A project install also writes a short reminder block into CLAUDE.md and
AGENTS.md, delimited by <!-- hod:begin --> / <!-- hod:end -->. Anything you
wrote outside those markers is preserved, re-running only replaces the block,
and uninstall removes it. Those files usually belong to the repository, so
review the diff — hod never commits. Skip it with --no-memo.

The block comes in two variants. The default reminds the agent to orchestrate
when you ask for work split across agents; --memo-strict declares a
Herdr-first project where, inside a Herdr pane, every implementation task
routes through Herdr workers (outside one it is a stated preference, never a
blocker). A plain re-install keeps whichever variant the project already has;
--memo-default explicitly switches back.

Settings profiles carry permission boundaries only — never credentials.
Claude Code merges them over the project's own settings, so tokens, endpoints
and hooks are inherited. Start a worker with them like this:

  herdr agent start reviewer --kind claude --pane "$pane" \
    -- --settings .claude/settings.reviewer.json

They apply to Claude Code workers only; Codex and Grok use their own flags.

Environment overrides (for tests and custom layouts):
  HOD_HOME         default: ~/.hod          (skill lives at $HOD_HOME/skill)
  HOD_BIN_DIR      default: ~/.local/bin
  HOD_CLAUDE_DIR   default: ~/.claude
  HOD_AGENTS_DIR   default: ~/.agents
  HOD_REPO_URL     default: official GitHub clone URL
EOF
}

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

usage_error() {
  printf 'error: %s\n' "$*" >&2
  usage >&2
  exit 2
}

resolve_paths() {
  local home_dir
  home_dir=${HOME:-}
  [[ -n "$home_dir" ]] || fail "HOME is not set"

  HOD_HOME=${HOD_HOME:-$home_dir/.hod}
  HOD_BIN_DIR=${HOD_BIN_DIR:-$home_dir/.local/bin}
  HOD_CLAUDE_DIR=${HOD_CLAUDE_DIR:-$home_dir/.claude}
  HOD_AGENTS_DIR=${HOD_AGENTS_DIR:-$home_dir/.agents}

  SKILL_DIR=$HOD_HOME/skill
  # Adapter directory name must match SKILL.md's `name:` field so the skill
  # resolves identically however it was installed. `hod` names the CLI only.
  SKILL_ADAPTER_NAME=herdr-orchestrator
  GLOBAL_CLAUDE_LINK=$HOD_CLAUDE_DIR/skills/$SKILL_ADAPTER_NAME
  GLOBAL_AGENTS_LINK=$HOD_AGENTS_DIR/skills/$SKILL_ADAPTER_NAME
  PROJECT_ADAPTER_REL_AGENTS=.agents/skills/$SKILL_ADAPTER_NAME
  PROJECT_ADAPTER_REL_CLAUDE=.claude/skills/$SKILL_ADAPTER_NAME
}

MEMO_BEGIN='<!-- hod:begin — managed by hod; edits inside this block are overwritten -->'
MEMO_END='<!-- hod:end -->'
MEMO_FILES="CLAUDE.md AGENTS.md"
# Phrase unique to the strict template; used to detect which variant a managed
# block carries so a plain re-install preserves the project's choice.
MEMO_STRICT_MARKER='Herdr-first project'

abs_path() {
  local target=$1

  if [[ -d "$target" ]]; then
    (cd -- "$target" && pwd -P)
    return
  fi

  local parent base
  parent=$(dirname -- "$target")
  base=$(basename -- "$target")
  if [[ -d "$parent" ]]; then
    printf '%s/%s\n' "$(cd -- "$parent" && pwd -P)" "$base"
  else
    printf '%s\n' "$target"
  fi
}

mark_ok() {
  printf '✓ %s\n' "$*"
}

mark_bad() {
  printf '✗ %s\n' "$*"
}

skill_commit() {
  if [[ -d "$SKILL_DIR/.git" ]]; then
    git -C "$SKILL_DIR" rev-parse --short HEAD 2>/dev/null || true
  fi
}

skill_has_local_changes() {
  [[ -d "$SKILL_DIR/.git" ]] || return 1
  ! git -C "$SKILL_DIR" diff --quiet 2>/dev/null || \
    ! git -C "$SKILL_DIR" diff --cached --quiet 2>/dev/null || \
    [[ -n "$(git -C "$SKILL_DIR" ls-files --others --exclude-standard 2>/dev/null)" ]]
}

adapter_resolves_to_skill() {
  local link=$1
  local resolved

  [[ -L "$link" ]] || return 1
  [[ -d "$link" ]] || return 1
  resolved=$(cd -- "$link" && pwd -P)
  [[ "$resolved" == "$(abs_path "$SKILL_DIR")" ]]
}

check_safe_parent() {
  local path=$1

  if [[ -L "$path" ]]; then
    fail "adapter parent must not be a symlink: $path"
  fi
  if [[ -e "$path" && ! -d "$path" ]]; then
    fail "adapter parent is not a directory: $path"
  fi
}

ensure_skill_checkout() {
  local ref=${1:-}
  local parent

  parent=$(dirname -- "$SKILL_DIR")
  mkdir -p -- "$parent"

  if [[ -d "$SKILL_DIR/.git" ]]; then
    printf 'skill checkout present: %s\n' "$SKILL_DIR"
    if skill_has_local_changes; then
      printf 'warning: skill checkout has local modifications; leaving tree unchanged\n' >&2
    else
      git -C "$SKILL_DIR" fetch --quiet origin 2>/dev/null || \
        git -C "$SKILL_DIR" fetch --quiet 2>/dev/null || true
      if [[ -n "$ref" ]]; then
        git -C "$SKILL_DIR" checkout --quiet "$ref" || \
          fail "failed to checkout ref: $ref"
        printf 'checked out ref: %s\n' "$ref"
      else
        if git -C "$SKILL_DIR" pull --ff-only --quiet 2>/dev/null; then
          printf 'updated skill checkout (ff-only)\n'
        else
          printf 'skill checkout left on current commit (ff-only not available)\n'
        fi
      fi
    fi
  else
    if [[ -e "$SKILL_DIR" ]]; then
      fail "skill path exists but is not a git checkout: $SKILL_DIR"
    fi
    printf 'cloning %s -> %s\n' "$HOD_REPO_URL" "$SKILL_DIR"
    git clone --quiet -- "$HOD_REPO_URL" "$SKILL_DIR" || \
      fail "failed to clone $HOD_REPO_URL"
    if [[ -n "$ref" ]]; then
      git -C "$SKILL_DIR" checkout --quiet "$ref" || \
        fail "failed to checkout ref: $ref"
      printf 'checked out ref: %s\n' "$ref"
    fi
  fi

  [[ -f "$SKILL_DIR/SKILL.md" ]] || fail "SKILL.md missing in $SKILL_DIR"
}

install_global_adapters() {
  local skill_abs created_agents=false created_claude=false
  skill_abs=$(abs_path "$SKILL_DIR")

  for parent_path in \
    "$HOD_AGENTS_DIR" \
    "$HOD_AGENTS_DIR/skills" \
    "$HOD_CLAUDE_DIR" \
    "$HOD_CLAUDE_DIR/skills"; do
    check_safe_parent "$parent_path"
  done

  mkdir -p -- "$HOD_AGENTS_DIR/skills" "$HOD_CLAUDE_DIR/skills"

  rollback_global() {
    local status=$?
    if [[ $status -ne 0 ]]; then
      if [[ "$created_agents" == true && -L "$GLOBAL_AGENTS_LINK" ]]; then
        rm -- "$GLOBAL_AGENTS_LINK"
        printf 'rolled back: %s\n' "$GLOBAL_AGENTS_LINK" >&2
      fi
      if [[ "$created_claude" == true && -L "$GLOBAL_CLAUDE_LINK" ]]; then
        rm -- "$GLOBAL_CLAUDE_LINK"
        printf 'rolled back: %s\n' "$GLOBAL_CLAUDE_LINK" >&2
      fi
    fi
  }
  trap rollback_global EXIT

  install_one_global() {
    local link=$1
    local label=$2

    if [[ -L "$link" ]]; then
      if adapter_resolves_to_skill "$link"; then
        printf 'already linked: %s\n' "$link"
        return 0
      fi
      fail "adapter exists but does not resolve to skill checkout: $link"
    fi
    if [[ -e "$link" ]]; then
      fail "adapter path already exists and is not a symlink: $link"
    fi
    ln -s -- "$skill_abs" "$link"
    printf 'linked: %s -> %s\n' "$link" "$skill_abs"
    if [[ "$label" == agents ]]; then
      created_agents=true
    else
      created_claude=true
    fi
  }

  install_one_global "$GLOBAL_AGENTS_LINK" agents
  install_one_global "$GLOBAL_CLAUDE_LINK" claude

  trap - EXIT
}


install_project_adapters_absolute() {
  local project_dir=$1
  local skill_abs
  local agents_link claude_link
  local created_agents=false created_claude=false
  local install_complete=false

  skill_abs=$(abs_path "$SKILL_DIR")
  agents_link=$project_dir/$PROJECT_ADAPTER_REL_AGENTS
  claude_link=$project_dir/$PROJECT_ADAPTER_REL_CLAUDE

  # Git is optional: outside a repository only the exclude step is skipped.
  local git_top
  if git_top=$(git -C "$project_dir" rev-parse --show-toplevel 2>/dev/null); then
    git_top=$(cd -- "$git_top" && pwd -P)
    [[ "$git_top" == "$project_dir" ]] || \
      fail "project must be at git worktree root: $project_dir (use --project $git_top)"
    [[ ! -L "$project_dir/.git" ]] || fail ".git marker must not be a symlink: $project_dir/.git"
  else
    printf 'skipped git exclude: %s is not a git worktree\n' "$project_dir" >&2
  fi

  for parent_path in \
    "$project_dir/.agents" \
    "$project_dir/.agents/skills" \
    "$project_dir/.claude" \
    "$project_dir/.claude/skills"; do
    check_safe_parent "$parent_path"
  done

  rollback_project() {
    local status=$?
    if [[ "$install_complete" != true && $status -ne 0 ]]; then
      if [[ "$created_agents" == true && -L "$agents_link" ]]; then
        rm -- "$agents_link"
        printf 'rolled back: %s\n' "$agents_link" >&2
      fi
      if [[ "$created_claude" == true && -L "$claude_link" ]]; then
        rm -- "$claude_link"
        printf 'rolled back: %s\n' "$claude_link" >&2
      fi
    fi
  }
  trap rollback_project EXIT

  install_one_project() {
    local link=$1
    local flag_name=$2

    if [[ -L "$link" ]]; then
      if [[ -d "$link" ]] && [[ "$(cd -- "$link" && pwd -P)" == "$skill_abs" ]]; then
        printf 'already linked: %s\n' "$link"
        return 0
      fi
      fail "adapter exists but does not resolve to skill checkout: $link"
    fi
    if [[ -e "$link" ]]; then
      fail "adapter path already exists and is not a symlink: $link"
    fi
    mkdir -p -- "$(dirname -- "$link")"
    check_safe_parent "$(dirname -- "$link")"
    ln -s -- "$skill_abs" "$link"
    printf 'linked: %s -> %s\n' "$link" "$skill_abs"
    if [[ "$flag_name" == agents ]]; then
      created_agents=true
    else
      created_claude=true
    fi
  }

  install_one_project "$agents_link" agents
  install_one_project "$claude_link" claude

  # Add both adapter paths to .git/info/exclude idempotently.
  if git -C "$project_dir" rev-parse --show-toplevel >/dev/null 2>&1; then
    local common_dir exclude_file entry
    common_dir=$(git -C "$project_dir" rev-parse --git-common-dir) || \
      fail "cannot resolve git common directory: $project_dir"
    case $common_dir in
      /*) ;;
      *) common_dir=$project_dir/$common_dir ;;
    esac
    [[ -d "$common_dir" ]] || fail "git common directory does not exist: $common_dir"
    common_dir=$(cd -- "$common_dir" && pwd -P)
    exclude_file=$common_dir/info/exclude
    mkdir -p -- "$(dirname -- "$exclude_file")"
    for entry in "$PROJECT_ADAPTER_REL_AGENTS" "$PROJECT_ADAPTER_REL_CLAUDE"; do
      if [[ -f "$exclude_file" ]] && grep -qxF -- "$entry" "$exclude_file"; then
        continue
      fi
      printf '%s\n' "$entry" >> "$exclude_file"
      printf 'excluded from git: %s\n' "$entry"
    done
  fi

  install_complete=true
  trap - EXIT
}

# Replace a file through a temporary sibling, keeping the original mode. mktemp
# creates 0600, which would silently tighten a repository file's permissions.
# GNU chmod has --reference; BSD does not, and its stat spells the mode
# differently, so validate whatever the fallback produces before trusting it.
# BSD chmod also rejects `--`, so no end-of-options marker here.
replace_preserving_mode() {
  local tmp=$1 file=$2
  local mode

  if [[ -f "$file" ]] && ! chmod "--reference=$file" "$tmp" 2>/dev/null; then
    mode=$(stat -f '%Lp' "$file" 2>/dev/null || stat -c '%a' "$file" 2>/dev/null || true)
    if [[ "$mode" =~ ^[0-7]{3,4}$ ]]; then
      chmod "$mode" "$tmp"
    fi
  fi
  mv -- "$tmp" "$file"
}

memo_body() {
  local variant=${1:-default}
  local template=$SKILL_DIR/templates/memo.md

  [[ "$variant" == strict ]] && template=$SKILL_DIR/templates/memo-strict.md
  [[ -f "$template" ]] || fail "memo template missing: $template"
  printf '%s\n' "$MEMO_BEGIN"
  cat -- "$template"
  printf '%s\n' "$MEMO_END"
}

# Report the variant of the managed block in a file: strict, default, or none.
# Only text between the markers counts — user prose outside them may
# legitimately use the same words.
managed_memo_variant() {
  local file=$1

  if [[ ! -f "$file" ]] || ! grep -qxF -- "$MEMO_BEGIN" "$file"; then
    printf 'none\n'
    return 0
  fi
  # BSD awk rejects a `--` end-of-options marker, so none is used here.
  if awk -v b="$MEMO_BEGIN" -v e="$MEMO_END" '$0==b{f=1;next} $0==e{f=0} f' \
      "$file" | grep -qF -- "$MEMO_STRICT_MARKER"; then
    printf 'strict\n'
  else
    printf 'default\n'
  fi
}

# Rewrite one memo file so exactly one hod-managed block is present. Content the
# user wrote outside the markers is preserved byte-for-byte.
write_memo_file() {
  local file=$1
  local variant=${2:-default}
  local tmp
  local begin_seen=false end_seen=false

  if [[ -e "$file" && ! -f "$file" ]]; then
    fail "memo path exists but is not a regular file: $file"
  fi
  if [[ -L "$file" ]]; then
    fail "memo path is a symlink; refusing to write through it: $file"
  fi

  if [[ ! -f "$file" ]]; then
    memo_body "$variant" >"$file"
    printf 'memo created: %s\n' "$file"
    return 0
  fi

  grep -qxF -- "$MEMO_BEGIN" "$file" && begin_seen=true
  grep -qxF -- "$MEMO_END" "$file" && end_seen=true
  if [[ "$begin_seen" != "$end_seen" ]]; then
    fail "memo markers are unbalanced in $file; fix or remove them by hand"
  fi

  tmp=$(mktemp "$file.hod.XXXXXX") || fail "cannot create temporary file next to $file"

  if [[ "$begin_seen" == true ]]; then
    local in_block=false replaced=false line
    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" == "$MEMO_BEGIN" ]]; then
        in_block=true
        if [[ "$replaced" == false ]]; then
          memo_body "$variant" >>"$tmp"
          replaced=true
        fi
        continue
      fi
      if [[ "$in_block" == true ]]; then
        [[ "$line" == "$MEMO_END" ]] && in_block=false
        continue
      fi
      printf '%s\n' "$line" >>"$tmp"
    done <"$file"
    printf 'memo updated: %s\n' "$file"
  else
    cat -- "$file" >"$tmp"
    # Separate from existing prose; harmless if the file already ends blank.
    printf '\n' >>"$tmp"
    memo_body "$variant" >>"$tmp"
    printf 'memo appended: %s\n' "$file"
  fi

  replace_preserving_mode "$tmp" "$file"
}

# Strip the managed block; leave everything else. A file that held nothing but
# the block was created by hod, so remove it rather than leave an empty stub.
strip_memo_file() {
  local file=$1
  local tmp in_block=false line

  [[ -f "$file" && ! -L "$file" ]] || return 0
  grep -qxF -- "$MEMO_BEGIN" "$file" || return 0

  tmp=$(mktemp "$file.hod.XXXXXX") || fail "cannot create temporary file next to $file"
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$MEMO_BEGIN" ]]; then
      in_block=true
      continue
    fi
    if [[ "$in_block" == true ]]; then
      [[ "$line" == "$MEMO_END" ]] && in_block=false
      continue
    fi
    printf '%s\n' "$line" >>"$tmp"
  done <"$file"

  if [[ ! -s "$tmp" ]] || ! grep -q '[^[:space:]]' "$tmp"; then
    rm -f -- "$tmp" "$file"
    printf 'memo removed, file was hod-only: %s\n' "$file"
    return 0
  fi

  replace_preserving_mode "$tmp" "$file"
  printf 'memo removed from: %s\n' "$file"
}

install_project_memo() {
  local project_dir=$1
  local requested=${2:-}   # empty: keep whatever variant each file already has
  local name file variant

  for name in $MEMO_FILES; do
    file=$project_dir/$name
    variant=$requested
    if [[ -z "$variant" ]]; then
      variant=$(managed_memo_variant "$file")
      [[ "$variant" == none ]] && variant=default
    fi
    write_memo_file "$file" "$variant"
  done
  printf 'memo files are yours to commit or discard; hod never commits\n'
}

uninstall_project_memo() {
  local project_dir=$1
  local name

  for name in $MEMO_FILES; do
    strip_memo_file "$project_dir/$name"
  done
}

cmd_install() {
  local project_path="" ref="" memo=true memo_variant=""

  while [[ $# -gt 0 ]]; do
    case $1 in
      --project)
        [[ $# -ge 2 ]] || usage_error "--project requires a path"
        project_path=$2
        shift 2
        ;;
      --ref)
        [[ $# -ge 2 ]] || usage_error "--ref requires a git ref"
        ref=$2
        shift 2
        ;;
      --no-memo)
        memo=false
        shift
        ;;
      --memo-strict)
        memo_variant=strict
        shift
        ;;
      --memo-default)
        memo_variant=default
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        usage_error "unknown install option: $1"
        ;;
    esac
  done

  command -v git >/dev/null 2>&1 || fail "git is required for install"
  ensure_skill_checkout "$ref"

  if [[ -n "$project_path" ]]; then
    [[ -d "$project_path" ]] || fail "project path is not an existing directory: $project_path"
    local project_dir
    project_dir=$(cd -- "$project_path" && pwd -P)

    printf 'installing absolute adapters into project: %s\n' "$project_dir"
    install_project_adapters_absolute "$project_dir"

    if [[ "$memo" == false && -n "$memo_variant" ]]; then
      usage_error "--no-memo conflicts with --memo-strict/--memo-default"
    fi
    if [[ "$memo" == true ]]; then
      install_project_memo "$project_dir" "$memo_variant"
    fi
  else
    # Memo flags only make sense with --project; failing loudly beats a
    # silent no-op the user believes took effect.
    if [[ -n "$memo_variant" || "$memo" == false ]]; then
      usage_error "memo options require --project"
    fi
    install_global_adapters
  fi

  # Ensure the executable is available when we have a skill checkout.
  if [[ -f "$SKILL_DIR/bin/hod" ]]; then
    mkdir -p -- "$HOD_BIN_DIR"
    if [[ -L "$HOD_BIN_DIR/hod" || ! -e "$HOD_BIN_DIR/hod" ]]; then
      ln -sfn -- "$SKILL_DIR/bin/hod" "$HOD_BIN_DIR/hod"
      chmod +x "$SKILL_DIR/bin/hod" 2>/dev/null || true
      printf 'installed executable: %s -> %s\n' "$HOD_BIN_DIR/hod" "$SKILL_DIR/bin/hod"
    elif [[ -f "$HOD_BIN_DIR/hod" ]]; then
      # Replace plain file copy with current skill binary when identical path type.
      cp -- "$SKILL_DIR/bin/hod" "$HOD_BIN_DIR/hod"
      chmod +x "$HOD_BIN_DIR/hod"
      printf 'updated executable: %s\n' "$HOD_BIN_DIR/hod"
    fi

    case ":${PATH:-}:" in
      *":$HOD_BIN_DIR:"*) ;;
      *)
        printf 'warning: %s is not on PATH. Add this line to your shell profile:\n' "$HOD_BIN_DIR" >&2
        printf '  export PATH="%s:$PATH"\n' "$HOD_BIN_DIR" >&2
        ;;
    esac
  fi

  local commit
  commit=$(skill_commit)
  printf 'install complete'
  if [[ -n "$commit" ]]; then
    printf ' (skill %s)' "$commit"
  fi
  printf '\n'
}

report_cmd_presence() {
  local name=$1
  local required=${2:-false}
  local path version_line

  if path=$(command -v "$name" 2>/dev/null); then
    version_line=$("$name" --version 2>/dev/null | head -n 1 || true)
    if [[ -n "$version_line" ]]; then
      mark_ok "$name: $version_line ($path)"
    else
      mark_ok "$name: present ($path)"
    fi
    return 0
  fi
  mark_bad "$name: not found"
  [[ "$required" == true ]] && return 1
  return 0
}

path_has_bin_dir() {
  case ":${PATH:-}:" in
    *":$HOD_BIN_DIR:"*) return 0 ;;
    *) return 1 ;;
  esac
}

cmd_status() {
  local ok=true
  local commit agents_ok=false

  report_cmd_presence herdr true || ok=false
  report_cmd_presence git true || ok=false
  report_cmd_presence jq true || ok=false

  if command -v claude >/dev/null 2>&1 || \
     command -v codex >/dev/null 2>&1 || \
     command -v grok >/dev/null 2>&1; then
    agents_ok=true
  fi
  report_cmd_presence claude false || true
  report_cmd_presence codex false || true
  report_cmd_presence grok false || true
  if [[ "$agents_ok" != true ]]; then
    mark_bad "agent CLIs: none of claude/codex/grok found"
    ok=false
  else
    mark_ok "agent CLIs: at least one present"
  fi

  if [[ -d "$SKILL_DIR/.git" ]]; then
    commit=$(skill_commit)
    mark_ok "skill checkout: $SKILL_DIR (commit ${commit:-unknown})"
  else
    mark_bad "skill checkout: missing ($SKILL_DIR)"
    ok=false
  fi

  if adapter_resolves_to_skill "$GLOBAL_AGENTS_LINK"; then
    mark_ok "global agents adapter: $GLOBAL_AGENTS_LINK"
  else
    mark_bad "global agents adapter: missing or broken ($GLOBAL_AGENTS_LINK)"
    ok=false
  fi

  if adapter_resolves_to_skill "$GLOBAL_CLAUDE_LINK"; then
    mark_ok "global claude adapter: $GLOBAL_CLAUDE_LINK"
  else
    mark_bad "global claude adapter: missing or broken ($GLOBAL_CLAUDE_LINK)"
    ok=false
  fi

  if path_has_bin_dir; then
    mark_ok "PATH includes $HOD_BIN_DIR"
  else
    mark_bad "PATH missing $HOD_BIN_DIR"
    ok=false
  fi

  if [[ "$ok" == true ]]; then
    exit 0
  fi
  exit 1
}

remediate() {
  printf '  → %s\n' "$*"
}

inspect_adapter() {
  local link=$1
  local label=$2
  local skill_abs resolved target

  skill_abs=$(abs_path "$SKILL_DIR" 2>/dev/null || printf '%s\n' "$SKILL_DIR")

  if [[ ! -e "$link" && ! -L "$link" ]]; then
    mark_bad "$label: missing ($link)"
    remediate "hod install"
    return 1
  fi

  if [[ -L "$link" ]]; then
    target=$(readlink "$link")
    if [[ ! -e "$link" ]]; then
      mark_bad "$label: dangling symlink ($link -> $target)"
      remediate "rm -- '$link' && hod install"
      return 1
    fi
    resolved=$(cd -- "$link" && pwd -P)
    if [[ "$resolved" != "$skill_abs" ]]; then
      mark_bad "$label: points elsewhere ($link -> $resolved, expected $skill_abs)"
      remediate "rm -- '$link' && hod install"
      return 1
    fi
    mark_ok "$label: $link -> $skill_abs"
    return 0
  fi

  mark_bad "$label: exists but is not a symlink ($link)"
  remediate "move or remove $link, then run: hod install"
  return 1
}

cmd_doctor() {
  local ok=true
  local commit

  # Mirror status checks with remediation.
  if command -v herdr >/dev/null 2>&1; then
    local herdr_ver
    herdr_ver=$(herdr --version 2>/dev/null | head -n 1 || true)
    mark_ok "herdr: ${herdr_ver:-present} ($(command -v herdr))"
  else
    mark_bad "herdr: not found"
    remediate "curl -fsSL https://herdr.dev/install.sh | sh"
    ok=false
  fi

  if command -v git >/dev/null 2>&1; then
    mark_ok "git: $(git --version 2>/dev/null | head -n 1) ($(command -v git))"
  else
    mark_bad "git: not found"
    remediate "install git via your OS package manager"
    ok=false
  fi

  if command -v jq >/dev/null 2>&1; then
    mark_ok "jq: $(jq --version 2>/dev/null | head -n 1) ($(command -v jq))"
  else
    mark_bad "jq: not found"
    remediate "install jq via your OS package manager"
    ok=false
  fi

  local any_agent=false
  for agent in claude codex grok; do
    if command -v "$agent" >/dev/null 2>&1; then
      mark_ok "$agent: present ($(command -v "$agent"))"
      any_agent=true
    else
      mark_bad "$agent: not found"
      remediate "install and authenticate the $agent CLI if you need that worker kind"
    fi
  done
  if [[ "$any_agent" != true ]]; then
    ok=false
  fi

  if [[ -d "$SKILL_DIR/.git" ]]; then
    commit=$(skill_commit)
    mark_ok "skill checkout: $SKILL_DIR (commit ${commit:-unknown})"
    if git -C "$SKILL_DIR" symbolic-ref -q HEAD >/dev/null 2>&1; then
      mark_ok "checkout mode: branch $(git -C "$SKILL_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null) ('hod update' fast-forwards)"
    else
      local pin_tag
      pin_tag=$(git -C "$SKILL_DIR" describe --tags --exact-match 2>/dev/null || true)
      if [[ -n "$pin_tag" ]]; then
        mark_ok "checkout mode: pinned to tag $pin_tag ('hod update' moves to the newest tag)"
      else
        mark_bad "checkout mode: detached at a non-tag commit"
        remediate "cd '$SKILL_DIR' && git checkout main   # or re-run install"
      fi
    fi
    if skill_has_local_changes; then
      mark_bad "skill checkout has local uncommitted changes"
      remediate "cd '$SKILL_DIR' && git status"
      remediate "commit, stash, or discard local changes before 'hod update'"
      ok=false
    else
      mark_ok "skill checkout is clean"
    fi
  else
    mark_bad "skill checkout: missing ($SKILL_DIR)"
    remediate "hod install"
    ok=false
  fi

  inspect_adapter "$GLOBAL_AGENTS_LINK" "global agents adapter" || ok=false
  inspect_adapter "$GLOBAL_CLAUDE_LINK" "global claude adapter" || ok=false

  if path_has_bin_dir; then
    mark_ok "PATH includes $HOD_BIN_DIR"
  else
    mark_bad "PATH missing $HOD_BIN_DIR"
    remediate "export PATH=\"$HOD_BIN_DIR:\$PATH\""
    ok=false
  fi

  if command -v herdr >/dev/null 2>&1; then
    if herdr integration status >/dev/null 2>&1; then
      mark_ok "herdr integration status: reachable (read-only check)"
      herdr integration status 2>/dev/null | sed 's/^/  /' || true
    else
      mark_bad "herdr integration status: unavailable or failed"
      remediate "run 'herdr integration status' manually; install integrations yourself if needed"
      # Not a hard failure of hod itself; leave ok as-is unless we want soft.
    fi
  fi

  if [[ "$ok" == true ]]; then
    exit 0
  fi
  exit 1
}

cmd_update() {
  command -v git >/dev/null 2>&1 || fail "git is required for update"
  [[ -d "$SKILL_DIR/.git" ]] || fail "skill checkout missing; run: hod install"

  if skill_has_local_changes; then
    fail "skill checkout has local modifications; refuse to update. Inspect: git -C $SKILL_DIR status"
  fi

  local old new upstream_ref current_branch
  old=$(git -C "$SKILL_DIR" rev-parse --short HEAD)

  # A pinned install (HOD_REF / --ref to a tag) leaves the checkout detached,
  # where branch updates cannot work. Only an exact tag is an updateable pin.
  if ! git -C "$SKILL_DIR" symbolic-ref -q HEAD >/dev/null 2>&1; then
    local pin_tag latest_tag
    pin_tag=$(git -C "$SKILL_DIR" describe --tags --exact-match 2>/dev/null || true)
    [[ -n "$pin_tag" ]] || \
      fail "checkout is detached at a non-tag commit; checkout an exact tag or branch"
    git -C "$SKILL_DIR" fetch --tags --quiet 2>/dev/null || \
      fail "failed to fetch tags; resolve manually in $SKILL_DIR"
    latest_tag=$(git -C "$SKILL_DIR" tag --sort=-v:refname | head -n 1)
    [[ -n "$latest_tag" ]] || \
      fail "checkout is detached and no tags exist; re-run install, or checkout a branch"
    git -C "$SKILL_DIR" checkout --quiet "refs/tags/$latest_tag" || \
      fail "failed to checkout tag: $latest_tag"
    new=$(git -C "$SKILL_DIR" rev-parse --short HEAD)
    printf 'updated pinned skill: %s → %s (%s)\n' "$old" "$new" "$latest_tag"
    return 0
  fi

  current_branch=$(git -C "$SKILL_DIR" symbolic-ref --quiet --short HEAD) || \
    fail "failed to resolve current branch in $SKILL_DIR"
  upstream_ref=$(git -C "$SKILL_DIR" for-each-ref \
    --format='%(upstream)' "refs/heads/$current_branch")

  if [[ -n "$upstream_ref" ]]; then
    local upstream_remote
    upstream_remote=$(git -C "$SKILL_DIR" config --get \
      "branch.$current_branch.remote" || true)
    if [[ -n "$upstream_remote" && "$upstream_remote" != "." ]]; then
      git -C "$SKILL_DIR" fetch --prune --tags --quiet "$upstream_remote" 2>/dev/null || \
        fail "failed to fetch upstream; resolve manually in $SKILL_DIR"
    fi
  else
    local matching_remote_branches=()
    local matching_remote_names=()
    local remote
    git -C "$SKILL_DIR" fetch --all --prune --tags --quiet 2>/dev/null || \
      fail "failed to fetch remotes; resolve manually in $SKILL_DIR"
    while IFS= read -r remote; do
      [[ -n "$remote" ]] || continue
      if git -C "$SKILL_DIR" show-ref --verify --quiet \
        "refs/remotes/$remote/$current_branch"; then
        matching_remote_branches+=("refs/remotes/$remote/$current_branch")
        matching_remote_names+=("$remote/$current_branch")
      fi
    done < <(git -C "$SKILL_DIR" remote | LC_ALL=C sort)

    if (( ${#matching_remote_branches[@]} == 0 )); then
      fail "branch '$current_branch' has no upstream and no unique remote branch named '$current_branch'"
    fi
    if (( ${#matching_remote_branches[@]} > 1 )); then
      local matching_display
      matching_display=$(printf ', %s' "${matching_remote_names[@]}")
      matching_display=${matching_display#, }
      fail "branch '$current_branch' has no upstream and multiple matching remote branches: $matching_display"
    fi
    upstream_ref=${matching_remote_branches[0]}
  fi

  git -C "$SKILL_DIR" merge --ff-only "$upstream_ref" || \
    fail "git pull --ff-only failed; resolve manually in $SKILL_DIR"
  new=$(git -C "$SKILL_DIR" rev-parse --short HEAD)
  printf 'updated skill: %s → %s\n' "$old" "$new"
}

resolve_ui_entry() {
  local installed_ui_dir=$SKILL_DIR/ui
  local installed_entry=$installed_ui_dir/server.mjs
  local repo_root repo_ui_dir repo_entry

  # A UI directory or entry symlink could redirect execution outside the
  # installed skill. Treat an unsafe installed candidate as an error rather
  # than silently falling back to a different checkout.
  if [[ -L "$installed_ui_dir" || -L "$installed_entry" ]]; then
    fail "unsafe UI entry path: $installed_entry"
  fi
  if [[ -e "$installed_ui_dir" && ! -d "$installed_ui_dir" ]]; then
    fail "UI entry directory is not a directory: $installed_ui_dir"
  fi
  if [[ -e "$installed_entry" ]]; then
    [[ -f "$installed_entry" ]] || fail "UI entry is not a regular file: $installed_entry"
    printf '%s\n' "$installed_entry"
    return 0
  fi

  repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P) ||
    fail "cannot resolve repository-relative UI entry"
  repo_ui_dir=$repo_root/ui
  repo_entry=$repo_ui_dir/server.mjs

  if [[ -L "$repo_ui_dir" || -L "$repo_entry" ]]; then
    fail "unsafe UI entry path: $repo_entry"
  fi
  [[ -f "$repo_entry" ]] ||
    fail "UI entry missing: expected $installed_entry or $repo_entry"
  printf '%s\n' "$repo_entry"
}

ui_entry_is_safe() {
  local entry=$1 parent
  parent=$(dirname -- "$entry")
  [[ ! -L "$parent" && -d "$parent" && -O "$parent" ]] || return 1
  [[ ! -L "$entry" && -f "$entry" && -O "$entry" ]] || return 1
}

resolve_node_20() {
  local node_bin node_version node_major

  node_bin=$(command -v node 2>/dev/null) ||
    fail "Node.js 20 or newer is required for hod ui"
  [[ -n "$node_bin" ]] || fail "Node.js 20 or newer is required for hod ui"

  # Capture and validate the version without evaluating any command output.
  node_version=$("$node_bin" --version 2>/dev/null) ||
    fail "Node.js 20 or newer is required for hod ui"
  if [[ ! "$node_version" =~ ^v([0-9]+)(\.[0-9]+){0,2}$ ]]; then
    fail "Node.js 20 or newer is required for hod ui"
  fi
  node_major=${BASH_REMATCH[1]}
  (( node_major >= 20 )) || fail "Node.js 20 or newer is required for hod ui"

  printf '%s\n' "$node_bin"
}

launch_ui() {
  local runtime_only=$1
  shift
  local ui_entry node_bin hod_bin
  local -a ui_argv

  ui_entry=$(resolve_ui_entry)
  node_bin=$(resolve_node_20)
  hod_bin=$0

  # Recheck ownership, regular-file type, and the immediate parent just before
  # exec. Pure shell cannot keep a directory fd while preserving Node's
  # relative-import resolution: a same-user process can still swap this path
  # after the check. That residual boundary is intentionally not fail-closed.
  ui_entry_is_safe "$ui_entry" || fail "unsafe UI entry path: $ui_entry"

  # The server owns UI option parsing. Keep argv as an array so spaces and
  # leading dashes remain data, never shell syntax; exec preserves status and
  # signal delivery after validation succeeds.
  ui_argv=(--hod-bin "$hod_bin" "$@")
  if [[ "$runtime_only" == true ]]; then
    ui_argv+=(--runtime-only)
  fi
  exec "$node_bin" "$ui_entry" "${ui_argv[@]}"
}

cmd_ui() {
  local arg
  for arg in "$@"; do
    [[ "$arg" == '--runtime-only' ]] || continue
    usage_error "ui does not accept --runtime-only"
  done
  launch_ui false "$@"
}

cmd_start() {
  local arg
  for arg in "$@"; do
    [[ "$arg" == '--project' ]] || continue
    usage_error "start does not accept --project"
  done

  # Keep the existing UI launcher, Node gate, entry safety, and signal path;
  # the private launcher boundary appends the internal runtime-only selector.
  launch_ui true "$@"
}

remove_if_managed_adapter() {
  local link=$1
  local skill_abs

  skill_abs=$(abs_path "$SKILL_DIR" 2>/dev/null || printf '%s\n' "$SKILL_DIR")

  if [[ ! -e "$link" && ! -L "$link" ]]; then
    printf 'absent: %s\n' "$link"
    return 0
  fi

  if [[ ! -L "$link" ]]; then
    printf 'skipped (not a symlink): %s\n' "$link"
    return 0
  fi

  if [[ -d "$link" ]]; then
    local resolved
    resolved=$(cd -- "$link" && pwd -P)
    if [[ "$resolved" == "$skill_abs" ]]; then
      rm -- "$link"
      printf 'removed: %s\n' "$link"
      return 0
    fi
  else
    # Dangling link: remove only if readlink target points under skill path textually
    # or the absolute skill dir.
    local target
    target=$(readlink "$link")
    case $target in
      "$skill_abs"|"$SKILL_DIR"|*/skill|*/skill/)
        rm -- "$link"
        printf 'removed dangling managed link: %s\n' "$link"
        return 0
        ;;
    esac
    # Also compare canonicalized parent of target string when absolute.
    if [[ "$target" == "$skill_abs" || "$target" == "$SKILL_DIR" ]]; then
      rm -- "$link"
      printf 'removed dangling managed link: %s\n' "$link"
      return 0
    fi
  fi

  printf 'skipped (does not resolve into skill checkout): %s\n' "$link"
}

cmd_uninstall() {
  local project_path="" purge=false memo=true

  while [[ $# -gt 0 ]]; do
    case $1 in
      --project)
        [[ $# -ge 2 ]] || usage_error "--project requires a path"
        project_path=$2
        shift 2
        ;;
      --purge)
        purge=true
        shift
        ;;
      --no-memo)
        memo=false
        shift
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        usage_error "unknown uninstall option: $1"
        ;;
    esac
  done

  if [[ -n "$project_path" ]]; then
    [[ -d "$project_path" ]] || fail "project path is not an existing directory: $project_path"
    local project_dir
    project_dir=$(cd -- "$project_path" && pwd -P)
    remove_if_managed_adapter "$project_dir/$PROJECT_ADAPTER_REL_AGENTS"
    remove_if_managed_adapter "$project_dir/$PROJECT_ADAPTER_REL_CLAUDE"
    if [[ "$memo" == true ]]; then
      uninstall_project_memo "$project_dir"
    fi
    printf 'left .git/info/exclude entries alone (harmless)\n'
  else
    remove_if_managed_adapter "$GLOBAL_AGENTS_LINK"
    remove_if_managed_adapter "$GLOBAL_CLAUDE_LINK"
  fi

  if [[ "$purge" == true ]]; then
    if [[ -e "$HOD_HOME" ]]; then
      rm -rf -- "$HOD_HOME"
      printf 'purged: %s\n' "$HOD_HOME"
    else
      printf 'purge: %s already absent\n' "$HOD_HOME"
    fi
    # Also remove executable if it points into the purged skill.
    if [[ -L "$HOD_BIN_DIR/hod" ]]; then
      local bin_target
      bin_target=$(readlink "$HOD_BIN_DIR/hod")
      case $bin_target in
        "$HOD_HOME"/*|"$SKILL_DIR"/*)
          rm -- "$HOD_BIN_DIR/hod"
          printf 'removed executable link: %s\n' "$HOD_BIN_DIR/hod"
          ;;
      esac
    fi
  fi
}

SETTINGS_ROLES="controller impl reviewer"

settings_template_path() {
  printf '%s/templates/settings-%s.json\n' "$SKILL_DIR" "$1"
}

settings_role_summary() {
  case $1 in
    controller) printf 'no file edits — enforces coordinator-only delegation\n' ;;
    impl) printf 'may edit code; cannot push, merge, hard-reset or tag\n' ;;
    reviewer) printf 'read-only — no edits, no writing git commands, no rm\n' ;;
    *) printf 'unknown role\n' ;;
  esac
}

cmd_settings_list() {
  local role template

  printf 'Available settings profiles (installed as .claude/settings.<role>.json):\n\n'
  for role in $SETTINGS_ROLES; do
    template=$(settings_template_path "$role")
    if [[ -f "$template" ]]; then
      printf '  %-11s %s\n' "$role" "$(settings_role_summary "$role")"
    else
      printf '  %-11s (template missing: %s)\n' "$role" "$template"
    fi
  done
  printf '\nProfiles set permission boundaries only; credentials and hooks are\n'
  printf 'inherited from the project and user settings Claude Code already loads.\n'
  printf '\nStart a Claude worker with a profile (native args go after --):\n\n'
  printf '  herdr agent start impl --kind claude --pane "$pane" \\\n'
  printf '    -- --continue --settings .claude/settings.impl.json\n'
  printf '  herdr agent start reviewer --kind claude --pane "$pane" \\\n'
  printf '    -- --settings .claude/settings.reviewer.json   # fresh session, never --continue\n'
  printf '\nEquivalent Codex flags (replace <abs-repo> with an absolute repo path):\n'
  printf '  herdr agent start reviewer --kind codex --pane "$pane" \\\n'
  printf '    -- -s read-only -c features.multi_agent=false  # fresh session\n'
  printf '  herdr agent start controller --kind codex --pane "$pane" \\\n'
  printf '    -- -s workspace-write --ask-for-approval never \\\n'
  printf '    -c sandbox_workspace_write.network_access=true \\\n'
  printf '    -c features.multi_agent=false  # read-only blocks the Herdr socket\n'
  printf '  herdr agent start impl --kind codex --pane "$pane" \\\n'
  printf '    -- -s workspace-write --ask-for-approval never \\\n'
  printf '    -c sandbox_workspace_write.network_access=true \\\n'
  printf '    -c '\''sandbox_workspace_write.writable_roots=["<abs-repo>/.git"]'\''\n'
  printf '\nNever combine a profile with --dangerously-skip-permissions: that flag\n'
  printf 'overrides every deny rule and the profile stops enforcing anything.\n'
}

# Resolve the project the settings profiles are written into: an explicit
# --project path, otherwise the caller's current directory.
resolve_settings_project() {
  local project_path=$1
  local project_dir

  [[ -n "$project_path" ]] || project_path=$PWD
  [[ -d "$project_path" ]] || fail "project path is not an existing directory: $project_path"
  project_dir=$(cd -- "$project_path" && pwd -P)

  # Git is optional: outside a repository only the exclude step is skipped.
  local git_top
  if git_top=$(git -C "$project_dir" rev-parse --show-toplevel 2>/dev/null); then
    git_top=$(cd -- "$git_top" && pwd -P)
    [[ "$git_top" == "$project_dir" ]] || \
      fail "project must be at git worktree root: $project_dir (use --project $git_top)"
    [[ ! -L "$project_dir/.git" ]] || fail ".git marker must not be a symlink: $project_dir/.git"
  else
    printf 'skipped git exclude: %s is not a git worktree\n' "$project_dir" >&2
  fi

  printf '%s\n' "$project_dir"
}

settings_exclude_entry() {
  local project_dir=$1
  local entry=$2
  local common_dir exclude_file

  # resolve_settings_project already reported the non-git case once.
  if ! git -C "$project_dir" rev-parse --show-toplevel >/dev/null 2>&1; then
    return 0
  fi

  common_dir=$(git -C "$project_dir" rev-parse --git-common-dir) || \
    fail "cannot resolve git common directory: $project_dir"
  case $common_dir in
    /*) ;;
    *) common_dir=$project_dir/$common_dir ;;
  esac
  [[ -d "$common_dir" ]] || fail "git common directory does not exist: $common_dir"
  common_dir=$(cd -- "$common_dir" && pwd -P)
  exclude_file=$common_dir/info/exclude
  mkdir -p -- "$(dirname -- "$exclude_file")"

  if [[ -f "$exclude_file" ]] && grep -qxF -- "$entry" "$exclude_file"; then
    return 0
  fi
  printf '%s\n' "$entry" >> "$exclude_file"
  printf 'excluded from git: %s\n' "$entry"
}

cmd_settings_install() {
  local project_path="" requested_role="" force=false
  local roles role template dest rel project_dir written=0

  while [[ $# -gt 0 ]]; do
    case $1 in
      --project)
        [[ $# -ge 2 ]] || usage_error "--project requires a path"
        project_path=$2
        shift 2
        ;;
      --role)
        [[ $# -ge 2 ]] || usage_error "--role requires a role name"
        requested_role=$2
        shift 2
        ;;
      --force)
        force=true
        shift
        ;;
      *)
        usage_error "unknown option for settings install: $1"
        ;;
    esac
  done

  if [[ -n "$requested_role" ]]; then
    case " $SETTINGS_ROLES " in
      *" $requested_role "*) roles=$requested_role ;;
      *) usage_error "unknown role: $requested_role (expected one of: $SETTINGS_ROLES)" ;;
    esac
  else
    roles=$SETTINGS_ROLES
  fi

  project_dir=$(resolve_settings_project "$project_path")
  check_safe_parent "$project_dir/.claude"
  mkdir -p -- "$project_dir/.claude"

  for role in $roles; do
    template=$(settings_template_path "$role")
    [[ -f "$template" ]] || fail "settings template missing: $template"

    rel=.claude/settings.$role.json
    dest=$project_dir/$rel

    if [[ -L "$dest" ]]; then
      fail "settings path is a symlink, refusing to write: $dest"
    fi
    if [[ -e "$dest" && "$force" != true ]]; then
      printf 'kept existing (use --force to overwrite): %s\n' "$dest"
      settings_exclude_entry "$project_dir" "$rel"
      continue
    fi

    cp -- "$template" "$dest"
    printf 'installed: %s (%s)\n' "$dest" "$(settings_role_summary "$role")"
    settings_exclude_entry "$project_dir" "$rel"
    written=$((written + 1))
  done

  printf '\n%d profile(s) written. Start a Claude worker with, for example:\n' "$written"
  printf '  herdr agent start reviewer --kind claude --pane "$pane" \\\n'
  printf '    -- --settings .claude/settings.reviewer.json\n'
}

cmd_settings() {
  [[ $# -gt 0 ]] || usage_error "settings requires a subcommand: list or install"

  local sub=$1
  shift

  case $sub in
    list)
      cmd_settings_list "$@"
      ;;
    install)
      cmd_settings_install "$@"
      ;;
    *)
      usage_error "unknown settings subcommand: $sub (expected list or install)"
      ;;
  esac
}

cmd_version() {
  printf 'hod %s\n' "$HOD_VERSION"
}

main() {
  resolve_paths

  if [[ $# -eq 0 ]]; then
    usage
    exit 0
  fi

  local cmd=$1
  shift

  case $cmd in
    install)
      cmd_install "$@"
      ;;
    status)
      cmd_status "$@"
      ;;
    doctor)
      cmd_doctor "$@"
      ;;
    update)
      cmd_update "$@"
      ;;
    uninstall)
      cmd_uninstall "$@"
      ;;
    settings)
      cmd_settings "$@"
      ;;
    ui)
      cmd_ui "$@"
      ;;
    start)
      cmd_start "$@"
      ;;
    version)
      cmd_version "$@"
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage_error "unknown command: $cmd"
      ;;
  esac
}

main "$@"
